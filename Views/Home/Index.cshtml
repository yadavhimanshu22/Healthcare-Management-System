@using Microsoft.AspNetCore.Identity
@using HealthcareManagementSystem.Models
@inject UserManager<ApplicationUser> UserManager

@{
    Layout = null;

    var loginEmail =
        TempData["LoginEmail"]?.ToString() ?? "";

    var loginRole =
        TempData["LoginRole"]?.ToString() ?? "";

    var loginError =
        TempData["LoginError"]?.ToString();

    var registrationSuccess =
        TempData["RegistrationSuccess"]?.ToString();

    var openLoginPopup =
        TempData["OpenLoginPopup"]?.ToString() == "true";

    var currentUser =
        User.Identity?.IsAuthenticated == true
            ? await UserManager.GetUserAsync(User)
            : null;

    var displayName =
        currentUser?.FullName
        ?? User.Identity?.Name
        ?? "My Account";

    var firstLetter =
        !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Trim().Substring(0, 1).ToUpper()
            : "U";
}
@{
    Layout = null;
}

