    @@media (max-width: 640px) {

        section.relative.bg-white h1 {

            font-size:
                2.6rem !important;

            line-height:
                1.08 !important;
        }


        #services-section,
        #departments-section,
        #booking-portal,
        #contact-section {

            background:
                #06152d !important;
        }

    }
