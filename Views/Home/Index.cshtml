    <!-- ========================================================= -->
    <!-- ================= REAL LOGIN MODAL ====================== -->
    <!-- ========================================================= -->

    <div id="loginModal"
         class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm hidden z-[100] flex items-center justify-center p-4">

        <div class="bg-white rounded-3xl max-w-md w-full shadow-2xl relative overflow-hidden">

            <!-- Login Header -->
            <div class="bg-gradient-to-br from-blue-700 via-blue-600 to-sky-500 px-6 py-7 text-white">

                <button type="button"
                        onclick="closeModal('loginModal')"
                        class="absolute top-4 right-4 w-9 h-9 rounded-xl bg-white/10 hover:bg-white/20 flex items-center justify-center transition">

                    <i data-lucide="x"
                       class="w-5 h-5"></i>

                </button>


                <div class="flex items-center gap-4">

                    <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center">

                        <i data-lucide="shield-check"
                           class="w-7 h-7">
                        </i>

                    </div>


                    <div>

                        <h3 class="text-xl font-extrabold">

                            System Portal Login

                        </h3>

                        <p class="text-xs text-blue-100 mt-1">

                            Secure Healthcare Management System

                        </p>

                    </div>

                </div>

            </div>


            <!-- Login Body -->
            <div class="p-6 sm:p-7">

                <!-- Login Error -->
                @if (TempData["LoginError"] != null)
                {
                    <div class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3">

                        <i data-lucide="circle-alert"
                           class="w-5 h-5 text-red-600 shrink-0 mt-0.5">
                        </i>

                        <div>

                            <p class="text-xs font-bold text-red-700">

                                Login Failed

                            </p>

                            <p class="text-xs text-red-600 mt-1">

                                @TempData["LoginError"]

                            </p>

                        </div>

                    </div>
                }


                <!-- ================================================= -->
                <!-- HOME PAGE LOGIN FORM -->
                <!-- ================================================= -->

                <form action="/Account/Login"
                      method="post"
                      class="space-y-5">

                    @Html.AntiForgeryToken()

                    <!-- Important: tells controller this login came from Home -->
                    <input type="hidden"
                           name="fromHome"
                           value="true" />


                    <!-- Email -->
                    <div>

                        <label for="loginEmail"
                               class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-2">

                            Email Address

                        </label>


                        <div class="relative">

                            <i data-lucide="mail"
                               class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400">
                            </i>


                            <input type="email"
                                   id="loginEmail"
                                   name="Email"
                                   required
                                   autocomplete="email"
                                   placeholder="admin@hospital.com"
                                   value="@TempData["LoginEmail"]"
                                   class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition" />

                        </div>

                    </div>


                    <!-- Password -->
                    <div>

                        <div class="flex items-center justify-between mb-2">

                            <label for="loginPassword"
                                   class="block text-xs font-bold text-slate-700 uppercase tracking-wide">

                                Password

                            </label>


                            <a href="/Account/ForgotPassword"
                               class="text-xs font-semibold text-blue-600 hover:text-blue-700">

                                Forgot Password?

                            </a>

                        </div>


                        <div class="relative">

                            <i data-lucide="lock"
                               class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400">
                            </i>


                            <input type="password"
                                   id="loginPassword"
                                   name="Password"
                                   required
                                   autocomplete="current-password"
                                   placeholder="Enter your password"
                                   class="w-full pl-10 pr-12 py-3 rounded-xl border border-slate-300 text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition" />


                            <button type="button"
                                    onclick="toggleLoginPassword()"
                                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-blue-600">

                                <i id="loginPasswordIcon"
                                   data-lucide="eye"
                                   class="w-4 h-4">
                                </i>

                            </button>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ROLE SELECTION - ONLY ON HOME LOGIN POPUP -->
                    <!-- ================================================= -->

                    <div>

                        <label for="loginRole"
                               class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-2">

                            Login As

                        </label>


                        <div class="relative">

                            <i data-lucide="users"
                               class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none">
                            </i>


                            <select id="loginRole"
                                    name="Role"
                                    required
                                    class="w-full pl-10 pr-10 py-3 rounded-xl border border-slate-300 text-sm text-slate-800 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition appearance-none">

                                <option value="">Select your role</option>

                                @if (TempData["LoginRole"]?.ToString() == "Administrator")
                                {
                                    <option value="Administrator" selected>
                                        Administrator
                                    </option>
                                }
                                else
                                {
                                    <option value="Administrator">
                                        Administrator
                                    </option>
                                }

                                @if (TempData["LoginRole"]?.ToString() == "Doctor")
                                {
                                    <option value="Doctor" selected>
                                        Doctor
                                    </option>
                                }
                                else
                                {
                                    <option value="Doctor">
                                        Doctor
                                    </option>
                                }

                                @if (TempData["LoginRole"]?.ToString() == "Patient")
                                {
                                    <option value="Patient" selected>
                                        Patient
                                    </option>
                                }
                                else
                                {
                                    <option value="Patient">
                                        Patient
                                    </option>
                                }

                                @if (TempData["LoginRole"]?.ToString() == "Receptionist")
                                {
                                    <option value="Receptionist" selected>
                                        Receptionist
                                    </option>
                                }
                                else
                                {
                                    <option value="Receptionist">
                                        Receptionist
                                    </option>
                                }

                                @if (TempData["LoginRole"]?.ToString() == "Laboratory")
                                {
                                    <option value="Laboratory" selected>
                                        Laboratory
                                    </option>
                                }
                                else
                                {
                                    <option value="Laboratory">
                                        Laboratory
                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <!-- Role Information -->
                    <div class="flex items-start gap-2 bg-blue-50 border border-blue-100 rounded-xl px-4 py-3">

                        <i data-lucide="info"
                           class="w-4 h-4 text-blue-600 mt-0.5 shrink-0">
                        </i>

                        <p class="text-[11px] leading-relaxed text-blue-700">

                            Select the role assigned to your account.
                            The system will verify your selected role before opening your authorized dashboard.

                        </p>

                    </div>


                    <!-- Sign In -->
                    <button type="submit"
                            class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-lg shadow-blue-500/20 hover:shadow-blue-500/30 transition flex items-center justify-center gap-2">

                        <i data-lucide="log-in"
                           class="w-4 h-4">
                        </i>

                        <span>
                            Sign In Securely
                        </span>

                    </button>

                </form>


                <!-- Divider -->
                <div class="relative my-6">

                    <div class="absolute inset-0 flex items-center">

                        <div class="w-full border-t border-slate-200"></div>

                    </div>

                    <div class="relative flex justify-center">

                        <span class="bg-white px-3 text-[11px] text-slate-400 font-medium">

                            New to the system?

                        </span>

                    </div>

                </div>


                <!-- Register -->
                <a href="/Account/Register"
                   class="w-full py-3 rounded-xl border border-slate-300 text-slate-700 hover:border-blue-400 hover:bg-blue-50 hover:text-blue-600 font-semibold text-sm transition flex items-center justify-center gap-2">

                    <i data-lucide="user-plus"
                       class="w-4 h-4">
                    </i>

                    Create New Account

                </a>


                <!-- Security -->
                <div class="flex justify-center items-center gap-2 mt-5">

                    <i data-lucide="shield"
                       class="w-3.5 h-3.5 text-emerald-500">
                    </i>

                    <span class="text-[10px] text-slate-400">

                        Secure authentication powered by ASP.NET Core Identity

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= SCRIPTS ========================= -->

    <script>

        const DEPARTMENTS = [

            {
                name: "Cardiology",
                desc: "Heart conditions, angiography, stenting, and coronary care.",
                icon: "heart-pulse",
                doctor: "Dr. A. K. Verma (Cardiologist)"
            },

            {
                name: "ENT",
                desc: "Ear, nose, throat diagnostics, sinus endoscopy, and audiology.",
                icon: "ear",
                doctor: "Dr. S. Mehra (ENT Specialist)"
            },

            {
                name: "Neurosurgery",
                desc: "Brain stroke, neuro-spine trauma, craniotomy, and neural repair.",
                icon: "brain",
                doctor: "Dr. R. Singhania (Neurosurgeon)"
            },

            {
                name: "Urology",
                desc: "Kidney stones, laser prostate surgery, lithotripsy, and bladder care.",
                icon: "activity",
                doctor: "Dr. P. Deshmukh (Urologist)"
            },

            {
                name: "Gynaecology",
                desc: "Maternity, high-risk pregnancy, IVF, and minimally invasive surgeries.",
                icon: "baby",
                doctor: "Dr. N. Joshi (Obstetrician & Gynaecologist)"
            },

            {
                name: "Orthopaedic",
                desc: "Joint replacement, fracture trauma, arthroscopy, and spine alignment.",
                icon: "bone",
                doctor: "Dr. M. Patel (Orthopaedic Surgeon)"
            },

            {
                name: "Ophthalmology",
                desc: "Cataract laser surgery, retina care, glaucoma, and vision correction.",
                icon: "eye",
                doctor: "Dr. V. Kapoor (Ophthalmologist)"
            },

            {
                name: "Plastic Surgery",
                desc: "Reconstructive, cosmetic, burn trauma recovery, and microvascular surgery.",
                icon: "sparkles",
                doctor: "Dr. T. Roy (Plastic Surgeon)"
            },

            {
                name: "Gastroenterology",
                desc: "Endoscopy, liver health, colonoscopy, and digestive tract disorders.",
                icon: "utensils",
                doctor: "Dr. K. Iyer (Gastroenterologist)"
            },

            {
                name: "Nephrology",
                desc: "Hemodialysis, chronic kidney failure therapy, and renal transplants.",
                icon: "shield",
                doctor: "Dr. H. Gupta (Nephrologist)"
            },

            {
                name: "Surgical Oncology",
                desc: "Comprehensive tumor excision, biopsy, and multidisciplinary cancer surgery.",
                icon: "ribbon",
                doctor: "Dr. S. Nair (Surgical Oncologist)"
            },

            {
                name: "General Surgery",
                desc: "Hernia repair, appendectomy, gallbladder excision, and trauma response.",
                icon: "scissors",
                doctor: "Dr. D. Sharma (General Surgeon)"
            }

        ];


        let queueData = [

            {
                token: "TKN-101",
                patient: "Vikas Malhotra",
                dept: "Cardiology",
                doc: "Dr. A. K. Verma",
                date: "2026-10-04",
                status: "Confirmed"
            },

            {
                token: "TKN-102",
                patient: "Sneha Nair",
                dept: "Orthopaedic",
                doc: "Dr. M. Patel",
                date: "2026-10-04",
                status: "In Waiting"
            },

            {
                token: "TKN-103",
                patient: "Amit Roy",
                dept: "Gastroenterology",
                doc: "Dr. K. Iyer",
                date: "2026-10-05",
                status: "Confirmed"
            }

        ];


        let currentSelectedTreatment = "";


        // =========================================================
        // DEPARTMENTS
        // =========================================================

        function renderDepartments() {

            const container =
                document.getElementById('departmentsContainer');

            if (!container) return;

            container.innerHTML = DEPARTMENTS.map(dept => `

                <div class="bg-white p-6 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition group">

                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4 group-hover:bg-blue-600 group-hover:text-white transition">

                        <i data-lucide="${dept.icon}" class="w-6 h-6"></i>

                    </div>

                    <h3 class="text-base font-bold text-slate-900 mb-1">

                        ${dept.name}

                    </h3>

                    <p class="text-xs text-slate-500 mb-4 line-clamp-2">

                        ${dept.desc}

                    </p>

                    <div class="border-t border-slate-100 pt-3 flex justify-between items-center text-xs">

                        <span class="text-slate-400 font-medium">

                            Head: ${dept.doctor.split('(')[0]}

                        </span>

                        <button type="button"
                                onclick="filterDepartment('${dept.name}')"
                                class="text-blue-600 font-bold hover:underline">

                            Consult &rarr;

                        </button>

                    </div>

                </div>

            `).join('');

            lucide.createIcons();
        }


        // =========================================================
        // DOCTOR LIST
        // =========================================================

        function updateDoctorsList() {

            const deptSelect =
                document.getElementById('departmentSelect');

            const docSelect =
                document.getElementById('doctorSelect');

            if (!deptSelect || !docSelect) return;

            const val = deptSelect.value;

            docSelect.innerHTML = '';

            if (!val) {

                docSelect.innerHTML =
                    '<option value="">-- Select Department First --</option>';

                return;
            }

            const match =
                DEPARTMENTS.find(d => d.name === val);

            if (match) {

                docSelect.innerHTML = `

                    <option value="${match.doctor}">
                        ${match.doctor}
                    </option>

                    <option value="Senior Registrar (${val})">
                        Senior Registrar (${val})
                    </option>

                `;

            }

        }


        // =========================================================
        // FILTER DEPARTMENT
        // =========================================================

        function filterDepartment(deptName) {

            scrollToSection('booking-portal');

            const deptSelect =
                document.getElementById('departmentSelect');

            if (!deptSelect) return;

            deptSelect.value = deptName;

            updateDoctorsList();

        }


        // =========================================================
        // TREATMENT MENU
        // =========================================================

        function toggleTreatmentsMegaMenu() {

            const menu =
                document.getElementById('treatmentsMegaMenu');

            if (!menu) return;

            menu.classList.toggle('hidden');

        }


        // =========================================================
        // MOBILE NAV
        // =========================================================

        function toggleMobileNav() {

            const mob =
                document.getElementById('mobileNav');

            if (!mob) return;

            mob.classList.toggle('hidden');

        }


        // =========================================================
        // TREATMENT MODAL
        // =========================================================

        function openTreatmentModal(treatmentTitle) {

            currentSelectedTreatment = treatmentTitle;

            const title =
                document.getElementById('modalTitle');

            const description =
                document.getElementById('modalDescription');

            const modal =
                document.getElementById('detailModal');

            if (!title || !description || !modal) return;

            title.innerText = treatmentTitle;

            description.innerText =
                `Our hospital's multidisciplinary team provides accredited care for "${treatmentTitle}". Includes pre-operative digital evaluations, robotic or minimally invasive pathways, and tailored post-procedure monitoring.`;

            modal.classList.remove('hidden');

            document
                .getElementById('treatmentsMegaMenu')
                .classList.add('hidden');

            lucide.createIcons();

        }


        // =========================================================
        // BOOK TREATMENT
        // =========================================================

        function bookThisTreatment() {

            closeModal('detailModal');

            scrollToSection('booking-portal');

            const t =
                currentSelectedTreatment.toLowerCase();

            const department =
                document.getElementById('departmentSelect');

            if (!department) return;

            if (
                t.includes('cancer') ||
                t.includes('t-cell')
            ) {

                department.value = 'Surgical Oncology';

            }

            else if (
                t.includes('heart') ||
                t.includes('cabg') ||
                t.includes('coronary')
            ) {

                department.value = 'Cardiology';

            }

            else if (
                t.includes('back') ||
                t.includes('disc') ||
                t.includes('spine') ||
                t.includes('arthritis') ||
                t.includes('osteoporosis')
            ) {

                department.value = 'Orthopaedic';

            }

            else if (
                t.includes('brain') ||
                t.includes('neuro')
            ) {

                department.value = 'Neurosurgery';

            }

            else if (t.includes('kidney')) {

                department.value = 'Nephrology';

            }

            else if (t.includes('laparoscopic')) {

                department.value = 'General Surgery';

            }

            else {

                department.value = 'General Surgery';

            }

            updateDoctorsList();

        }


        // =========================================================
        // BOOKING
        // =========================================================

        function handleBooking(e) {

            e.preventDefault();

            const name =
                document.getElementById('patientName').value;

            const phone =
                document.getElementById('patientPhone').value;

            const dept =
                document.getElementById('departmentSelect').value;

            const doctor =
                document.getElementById('doctorSelect').value;

            const date =
                document.getElementById('appointmentDate').value;

            const slot =
                document.getElementById('timeSlot').value;


            const randomToken =
                "TKN-" +
                Math.floor(1000 + Math.random() * 9000);


            queueData.unshift({

                token: randomToken,

                patient: name,

                dept: dept,

                doc: doctor.split('(')[0],

                date: date,

                status: "Confirmed"

            });


            renderQueueTable();


            const ticketContent =
                document.getElementById('ticketContent');


            ticketContent.innerHTML = `

                <div class="bg-blue-600 text-white rounded-xl p-4 text-center">

                    <span class="text-xs uppercase tracking-widest text-blue-200">

                        OPD Consultation Token

                    </span>

                    <div class="text-3xl font-extrabold my-1">

                        ${randomToken}

                    </div>

                    <span class="text-xs bg-blue-500/60 px-3 py-1 rounded-full font-medium">

                        ${date} | ${slot}

                    </span>

                </div>


                <div class="space-y-2 pt-2 text-xs">

                    <div class="flex justify-between py-1 border-b border-slate-200">

                        <span class="text-slate-500">

                            Patient:

                        </span>

                        <span class="font-bold text-slate-800">

                            ${name} (${phone})

                        </span>

                    </div>


                    <div class="flex justify-between py-1 border-b border-slate-200">

                        <span class="text-slate-500">

                            Department:

                        </span>

                        <span class="font-bold text-blue-600">

                            ${dept}

                        </span>

                    </div>


                    <div class="flex justify-between py-1 border-b border-slate-200">

                        <span class="text-slate-500">

                            Consultant:

                        </span>

                        <span class="font-bold text-slate-800">

                            ${doctor}

                        </span>

                    </div>

                </div>


                <button type="button"
                        onclick="window.print()"
                        class="w-full mt-3 py-2 bg-slate-900 text-white text-xs font-bold rounded-lg hover:bg-slate-800 transition">

                    Print OPD Slip

                </button>

            `;


            alert(
                `Appointment Confirmed! Token: ${randomToken}`
            );

        }


        // =========================================================
        // QUEUE TABLE
        // =========================================================

        function renderQueueTable() {

            const tbody =
                document.getElementById('queueTableBody');

            if (!tbody) return;

            tbody.innerHTML =
                queueData.map((item, index) => `

                    <tr class="hover:bg-slate-50">

                        <td class="py-3 px-4 font-mono font-bold text-blue-600">

                            ${item.token}

                        </td>

                        <td class="py-3 px-4 font-semibold text-slate-800">

                            ${item.patient}

                        </td>

                        <td class="py-3 px-4">

                            ${item.dept}

                        </td>

                        <td class="py-3 px-4">

                            ${item.doc}

                        </td>

                        <td class="py-3 px-4 text-xs">

                            ${item.date}

                        </td>

                        <td class="py-3 px-4">

                            <span class="px-2 py-0.5 rounded text-xs font-bold
                                ${item.status === 'Confirmed'
                                    ? 'bg-emerald-100 text-emerald-700'
                                    : 'bg-amber-100 text-amber-700'}">

                                ${item.status}

                            </span>

                        </td>

                        <td class="py-3 px-4 text-right">

                            <button type="button"
                                    onclick="cancelAppointment(${index})"
                                    class="text-xs text-rose-600 hover:underline">

                                Cancel

                            </button>

                        </td>

                    </tr>

                `).join('');

        }


        // =========================================================
        // CANCEL APPOINTMENT
        // =========================================================

        function cancelAppointment(index) {

            if (confirm('Cancel this appointment slot?')) {

                queueData.splice(index, 1);

                renderQueueTable();

            }

        }


        // =========================================================
        // TABS
        // =========================================================

        function switchTab(tabId) {

            [
                'tab-book',
                'tab-queue',
                'tab-roles'
            ].forEach(id => {

                const element =
                    document.getElementById(id);

                if (element) {

                    element.classList.add('hidden');

                }

            });


            const activeTab =
                document.getElementById(tabId);

            if (activeTab) {

                activeTab.classList.remove('hidden');

            }


            [
                'btn-tab-book',
                'btn-tab-queue',
                'btn-tab-roles'
            ].forEach(btn => {

                const element =
                    document.getElementById(btn);

                if (element) {

                    element.className =
                        "px-3.5 py-1.5 text-xs font-semibold rounded-lg text-slate-300 hover:text-white transition";

                }

            });


            const activeButton =
                document.getElementById('btn-' + tabId);

            if (activeButton) {

                activeButton.className =
                    "px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 text-white transition";

            }

        }


        // =========================================================
        // CLOSE MODAL
        // =========================================================

        function closeModal(modalId) {

            const modal =
                document.getElementById(modalId);

            if (!modal) return;

            modal.classList.add('hidden');

            document.body.classList.remove('overflow-hidden');

        }


        // =========================================================
        // REAL LOGIN MODAL
        // =========================================================

        function openLoginModal() {

            const modal =
                document.getElementById('loginModal');

            if (!modal) return;

            modal.classList.remove('hidden');

            document.body.classList.add('overflow-hidden');


            setTimeout(() => {

                const emailInput =
                    document.getElementById('loginEmail');

                if (emailInput) {

                    emailInput.focus();

                }

            }, 100);


            lucide.createIcons();

        }


        // =========================================================
        // SHOW / HIDE LOGIN PASSWORD
        // =========================================================

        function toggleLoginPassword() {

            const passwordInput =
                document.getElementById('loginPassword');

            const icon =
                document.getElementById('loginPasswordIcon');

            if (!passwordInput || !icon) return;


            if (passwordInput.type === 'password') {

                passwordInput.type = 'text';

                icon.setAttribute(
                    'data-lucide',
                    'eye-off'
                );

            }

            else {

                passwordInput.type = 'password';

                icon.setAttribute(
                    'data-lucide',
                    'eye'
                );

            }


            lucide.createIcons();

        }


        // =========================================================
        // CLOSE MODAL ON OUTSIDE CLICK
        // =========================================================

        document.addEventListener('click', function (event) {

            const modal =
                document.getElementById('loginModal');

            if (!modal) return;

            if (modal.classList.contains('hidden')) {

                return;

            }


            if (event.target === modal) {

                closeModal('loginModal');

            }

        });


        // =========================================================
        // CLOSE LOGIN WITH ESCAPE
        // =========================================================

        document.addEventListener('keydown', function (event) {

            if (event.key !== 'Escape') {

                return;

            }


            const loginModal =
                document.getElementById('loginModal');

            if (
                loginModal &&
                !loginModal.classList.contains('hidden')
            ) {

                closeModal('loginModal');

            }


            const detailModal =
                document.getElementById('detailModal');

            if (
                detailModal &&
                !detailModal.classList.contains('hidden')
            ) {

                closeModal('detailModal');

            }

        });


        // =========================================================
        // SCROLL
        // =========================================================

        function scrollToSection(id) {

            const element =
                document.getElementById(id);

            if (!element) return;

            element.scrollIntoView({
                behavior: 'smooth'
            });

        }


        // =========================================================
        // PAGE LOAD
        // =========================================================

        window.addEventListener('DOMContentLoaded', () => {

            renderDepartments();

            renderQueueTable();


            const appointmentDate =
                document.getElementById('appointmentDate');


            if (appointmentDate) {

                const today =
                    new Date()
                        .toISOString()
                        .split('T')[0];

                appointmentDate.value = today;

            }


            lucide.createIcons();


            // =====================================================
            // LOGIN ERROR -> AUTOMATICALLY OPEN LOGIN POPUP
            // =====================================================

            const loginErrorExists =
    @((TempData["LoginError"] != null).ToString().ToLower());

const openLoginPopup =
    @((TempData["OpenLoginPopup"]?.ToString() == "true").ToString().ToLower());

if (loginErrorExists || openLoginPopup) {
    setTimeout(() => {
        openLoginModal();
    }, 150);
}

        });

    </script>

</body>
</html>