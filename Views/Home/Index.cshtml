        box-shadow:
            0 20px 45px rgba(0,0,0,.25) !important;
    }


    /* =========================================================
       HEART ANIMATION
    ========================================================= */

    @@keyframes heartbeat {

        0% {
            transform: scale(1);
        }

        14% {
            transform: scale(1.10);
        }

        28% {
            transform: scale(1);
        }

        42% {
            transform: scale(1.15);
        }

        70% {
            transform: scale(1);
        }

    }


    .heart-pulse {

        animation:
            heartbeat 2s infinite ease-in-out;
    }


    /* =========================================================
       SCROLLBAR
    ========================================================= */

    ::-webkit-scrollbar {

        width: 9px;
    }


    ::-webkit-scrollbar-track {

        background:
            #030b19;
    }


    ::-webkit-scrollbar-thumb {

        background:
            #671625;

        border-radius:
            10px;
    }


    ::-webkit-scrollbar-thumb:hover {

        background:
            #96263f;
    }


    /* =========================================================
       SELECTION
    ========================================================= */

    ::selection {

        background:
            #8a2037;

        color:
            #ffffff;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 768px) {

        header.sticky {

            background:
                linear-gradient(
                    135deg,
                    #350b12,
                    #711827
