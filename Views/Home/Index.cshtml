    border-radius: 12px !important;
}

#loginModal button[type="submit"]:hover {
    background: linear-gradient(
        135deg,
        #ca3858,
        #982440
    ) !important;

    box-shadow: 0 5px 16px rgba(190, 35, 65, 0.25) !important;
}
