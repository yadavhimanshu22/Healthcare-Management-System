/* Email, Password and Role fields */
#loginModal input:not([type="hidden"]):not([type="checkbox"]),
#loginModal select,
#loginModal textarea {
    background: #0b2340 !important;
    color: #f8fafc !important;
    border: 1px solid #304966 !important;
    border-radius: 12px !important;
    outline: none !important;
    transition: border-color .2s ease,
                box-shadow .2s ease,
                background .2s ease !important;
}

/* Red shadow for all fields */
#loginModal input:not([type="hidden"]):not([type="checkbox"]):focus,
#loginModal select:focus,
#loginModal textarea:focus {
    background: #0d2542 !important;
    color: #ffffff !important;
    border: 1px solid #ef4765 !important;
    box-shadow:
        0 0 0 2px rgba(239, 71, 101, 0.20),
        0 0 14px rgba(190, 35, 65, 0.22) !important;
}

/* Placeholder color */
#loginModal input::placeholder,
#loginModal textarea::placeholder {
    color: #91a5bf !important;
    opacity: 1 !important;
}

/* Browser autofill background fix */
#loginModal input:-webkit-autofill,
#loginModal input:-webkit-autofill:hover,
#loginModal input:-webkit-autofill:focus {
    -webkit-text-fill-color: #f8fafc !important;
    caret-color: #ffffff !important;
    -webkit-box-shadow: 0 0 0 1000px #0b2340 inset !important;
    box-shadow: 0 0 0 1000px #0b2340 inset !important;
    border: 1px solid #304966 !important;
}

/* Role dropdown */
#loginModal select {
    color-scheme: dark;
    cursor: pointer;
}

/* Role list options */
#loginModal select option {
    background: #17202b !important;
    color: #ffffff !important;
}

/* Selected role */
#loginModal select option:checked {
    background: #a82440 !important;
    color: #ffffff !important;
}

/* Red focus border similar to screenshot */
#loginModal select:focus-visible {
    outline: 1px solid #ff637d !important;
    outline-offset: 2px;
}

/* Create New Account - charcoal red */
#loginModal a[href*="Register"] {
    background: linear-gradient(
        135deg,
        #29252c 0%,
        #45202b 48%,
        #701d32 100%
    ) !important;

    color: #fff1f3 !important;
    border: 1px solid #9e3a50 !important;
    border-radius: 12px !important;

    box-shadow:
        0 5px 15px rgba(91, 19, 39, 0.22),
        inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;

    transition: all .22s ease !important;
}

/* Create Account hover */
#loginModal a[href*="Register"]:hover {
    background: linear-gradient(
        135deg,
        #393039 0%,
        #642335 50%,
        #922841 100%
    ) !important;

    color: #ffffff !important;
    border-color: #e15a73 !important;

    box-shadow:
        0 0 0 2px rgba(225, 90, 115, 0.12),
        0 7px 20px rgba(145, 28, 57, 0.30) !important;

    transform: translateY(-1px);
}

/* Create Account keyboard focus */
#loginModal a[href*="Register"]:focus-visible {
    outline: 2px solid #ff7188 !important;
    outline-offset: 3px;
}

/* Keep the secure sign-in button red */
#loginModal button[type="submit"] {
    background: linear-gradient(
        135deg,
        #b52d4d,
        #821b36
    ) !important;

    color: #ffffff !important;
