@model IEnumerable<Appointment>
@{ ViewData["Title"]="Appointment Management"; }
<div class="container-fluid py-4"><div class="d-flex justify-content-between mb-4"><div><h1 class="h3 fw-bold">Appointment Management</h1><p class="text-secondary">Monitor and update appointment status.</p></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Reason</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Patient?.FullName</td><td>@a.Doctor?.FullName</td><td>@a.AppointmentDate.ToString("dd-MM-yyyy")</td><td>@a.AppointmentTime</td><td>@a.Reason</td><td><span class="badge text-bg-light">@a.Status</span></td><td><div class="d-flex gap-2"><form asp-action="UpdateAppointmentStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.AppointmentId"><select name="status" class="form-select form-select-sm" onchange="this.form.submit()"><option selected="@(a.Status=="Pending")">Pending</option><option selected="@(a.Status=="Confirmed")">Confirmed</option><option selected="@(a.Status=="Completed")">Completed</option><option selected="@(a.Status=="Cancelled")">Cancelled</option></select></form><form asp-action="DeleteAppointment" method="post" onsubmit="return confirm('Delete appointment?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.AppointmentId"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>} @if(!Model.Any()){<tr><td colspan="7" class="text-center py-5 text-secondary">No appointments found.</td></tr>}</tbody></table></div></div></div>
