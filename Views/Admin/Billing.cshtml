@model IEnumerable<Bill>
@{ ViewData["Title"]="Billing & Payments"; var patients=ViewBag.Patients as List<Patient>??new(); }
<div class="container-fluid py-4"><h1 class="h3 fw-bold">Billing & Payments</h1><p class="text-secondary">Create bills and manage payment status.</p>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form asp-action="AddBill" method="post" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-4"><select name="PatientId" class="form-select" required><option value="">Patient</option>@foreach(var p in patients){<option value="@p.PatientId">@p.FullName</option>}</select></div><div class="col-md-2"><input name="ConsultationFee" type="number" step="0.01" class="form-control" placeholder="Consultation"></div><div class="col-md-2"><input name="LabCharges" type="number" step="0.01" class="form-control" placeholder="Lab"></div><div class="col-md-2"><input name="MedicineCharges" type="number" step="0.01" class="form-control" placeholder="Medicine"></div><div class="col-md-2"><input name="OtherCharges" type="number" step="0.01" class="form-control" placeholder="Other"></div><div class="col-md-2"><input name="Discount" type="number" step="0.01" class="form-control" placeholder="Discount"></div><div class="col-md-2"><input name="Tax" type="number" step="0.01" class="form-control" placeholder="Tax"></div><div class="col-md-3"><select name="PaymentStatus" class="form-select"><option>Pending</option><option>Paid</option></select></div><div class="col-md-3"><button class="btn btn-primary w-100">Create Bill</button></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-light"><tr><th>Date</th><th>Patient</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")</td><td>@b.Patient?.FullName</td><td>₹@b.TotalAmount.ToString("N2")</td><td>@b.PaymentStatus</td><td><form asp-action="UpdateBillStatus" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.BillId"><select name="paymentStatus" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()"><option selected="@(b.PaymentStatus=="Pending")">Pending</option><option selected="@(b.PaymentStatus=="Paid")">Paid</option></select></form> <form asp-action="DeleteBill" method="post" class="d-inline" onsubmit="return confirm('Delete bill?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.BillId"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>} @if(!Model.Any()){<tr><td colspan="5" class="text-center py-4 text-secondary">No bills found.</td></tr>}</tbody></table></div></div></div>
