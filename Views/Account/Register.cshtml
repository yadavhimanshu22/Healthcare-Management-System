@model HealthcareManagementSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Create Account - HealthCare Management System</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>

        /* ============================================================
           REGISTER / CREATE ACCOUNT
           PROFESSIONAL CHARCOAL + DARK RED HEALTHCARE THEME
        ============================================================ */

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            background: #06152D;
        }

        body {
            margin: 0;
            min-height: 100vh;

            background:
                radial-gradient(
                    circle at 85% 8%,
                    rgba(189, 54, 84, 0.14),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 10% 90%,
                    rgba(25, 28, 59, 0.25),
                    transparent 35%
                ),
                linear-gradient(
                    135deg,
                    #06152D 0%,
                    #081D3B 55%,
                    #07152B 100%
                ) !important;

            color: #FFFFFF !important;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* ============================================================
           MAIN CONTAINER
        ============================================================ */

        .register-container {
            background:
                radial-gradient(
                    circle at 90% 5%,
                    rgba(189, 54, 84, 0.08),
                    transparent 32%
                ),
                linear-gradient(
                    145deg,
                    #081D3B,
                    #06152D
                ) !important;

            color: #FFFFFF !important;
        }


        /* ============================================================
           MAIN REGISTER CARD
        ============================================================ */

        .register-card {

            background:
                linear-gradient(
                    145deg,
                    #292A30 0%,
                    #202126 55%,
                    #18191D 100%
                ) !important;

            color: #FFFFFF !important;

            border:
                1px solid rgba(255, 255, 255, 0.08) !important;

            border-radius:
                20px !important;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.45),
                0 8px 25px rgba(0, 0, 0, 0.25) !important;

            overflow: hidden !important;
        }


        /* ============================================================
           ⭐ HEADER
           BLUE/CYAN → CHARCOAL + DARK RED
        ============================================================ */

        .register-card > div:first-child {

            background:
                linear-gradient(
                    135deg,
                    #3A252B 0%,
                    #33272C 30%,
                    #292A30 65%,
                    #202126 100%
                ) !important;

            background-color:
                #292A30 !important;

            color:
                #FFFFFF !important;

            border-bottom:
                1px solid rgba(189, 54, 84, 0.35) !important;

            position:
                relative !important;

            overflow:
                hidden !important;
        }


        /* ============================================================
           HEADER RED GLOW
        ============================================================ */

        .register-card > div:first-child::after {

            content: "";

            position: absolute;

            top: -100px;
            right: -100px;

            width: 260px;
            height: 260px;

            background:
                radial-gradient(
                    circle,
                    rgba(189, 54, 84, 0.25),
                    transparent 68%
                );

            pointer-events:
                none;

            z-index:
                0;
        }


        .register-card > div:first-child > * {

            position:
                relative;

            z-index:
                1;
        }


        /* ============================================================
           FORCE REMOVE TAILWIND BLUE/CYAN GRADIENT
        ============================================================ */

        .register-card > div:first-child[class*="bg-gradient"],
        .register-card > div:first-child[class*="from-blue"],
        .register-card > div:first-child[class*="from-cyan"],
        .register-card > div:first-child[class*="from-sky"],
        .register-card > div:first-child[class*="to-blue"],
        .register-card > div:first-child[class*="to-cyan"],
        .register-card > div:first-child[class*="to-sky"] {

            background:
                linear-gradient(
                    135deg,
                    #3A252B 0%,
                    #33272C 30%,
                    #292A30 65%,
                    #202126 100%
                ) !important;

            background-color:
                #292A30 !important;
        }


        /* ============================================================
           ANY BLUE/CYAN ELEMENT INSIDE HEADER
        ============================================================ */

        .register-card > div:first-child .bg-blue-400,
        .register-card > div:first-child .bg-blue-500,
        .register-card > div:first-child .bg-blue-600,
        .register-card > div:first-child .bg-blue-700,
        .register-card > div:first-child .bg-cyan-400,
        .register-card > div:first-child .bg-cyan-500,
        .register-card > div:first-child .bg-cyan-600,
        .register-card > div:first-child .bg-sky-400,
        .register-card > div:first-child .bg-sky-500,
        .register-card > div:first-child .bg-sky-600 {

            background:
                linear-gradient(
                    135deg,
                    #7F2038,
                    #521B2A
                ) !important;

            background-color:
                #671F31 !important;

            color:
                #FFFFFF !important;
        }


        /* ============================================================
           HEALTHCARE LOGO BOX
        ============================================================ */

        .register-card > div:first-child .bg-white\/20,
        .register-card > div:first-child [class*="bg-white/20"],
        .register-card > div:first-child [class*="bg-blue-400"],
        .register-card > div:first-child [class*="bg-blue-500"] {

            background:
                linear-gradient(
                    145deg,
                    #633040,
                    #3D242C
                ) !important;

            border:
                1px solid rgba(224, 90, 114, 0.30) !important;

            box-shadow:
                0 8px 20px rgba(0, 0, 0, 0.25),
                inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;

            color:
                #FFFFFF !important;
        }


        /* ============================================================
           HEART ICON
        ============================================================ */

        .register-card > div:first-child span {

            color:
                #FF4F6D !important;

            text-shadow:
                0 4px 10px rgba(189, 54, 84, 0.35);
        }


        .register-card > div:first-child i,
        .register-card > div:first-child svg {

            color:
                #FF4F6D !important;

            filter:
                drop-shadow(
                    0 4px 8px rgba(189, 54, 84, 0.35)
                );
        }


        /* ============================================================
           HEADER TITLES
        ============================================================ */

        .register-card > div:first-child h1,
        .register-card > div:first-child h2,
        .register-card > div:first-child h3 {

            color:
                #FFFFFF !important;

            font-weight:
                700 !important;

            letter-spacing:
                -0.3px;
        }


        .register-card > div:first-child h1 {

            text-shadow:
                0 3px 15px rgba(0, 0, 0, 0.25);
        }


        /* ============================================================
           HEADER PARAGRAPH
        ============================================================ */

        .register-card > div:first-child p {

            color:
                #C3C4CA !important;
        }


        /* ============================================================
           HEADER BLUE TEXT → WHITE
        ============================================================ */

        .register-card > div:first-child .text-blue-50,
        .register-card > div:first-child .text-blue-100,
        .register-card > div:first-child .text-blue-200,
        .register-card > div:first-child .text-blue-300,
        .register-card > div:first-child .text-blue-400,
        .register-card > div:first-child .text-blue-500,
        .register-card > div:first-child .text-blue-600,
        .register-card > div:first-child .text-blue-700,
        .register-card > div:first-child .text-blue-800,
        .register-card > div:first-child .text-cyan-400,
        .register-card > div:first-child .text-cyan-500 {

            color:
                #FFFFFF !important;
        }


        /* ============================================================
           FORM AREA
        ============================================================ */

        .register-card > .p-8 {

            background:
                linear-gradient(
                    145deg,
                    #292A30,
                    #202126
                ) !important;

            color:
                #FFFFFF !important;
        }


        .register-form,
        .form-container {

            background:
                transparent !important;

            color:
                #FFFFFF !important;
        }


        /* ============================================================
           HEADINGS
        ============================================================ */

        .register-container h1,
        .register-container h2,
        .register-container h3,
        .register-card h1,
        .register-card h2,
        .register-card h3,
        .register-form h1,
        .register-form h2,
        .register-form h3,
        .form-container h1,
        .form-container h2,
        .form-container h3 {

            color:
                #FFFFFF !important;

            font-weight:
                700 !important;
        }


        /* ============================================================
           PARAGRAPHS
        ============================================================ */

        .register-container p,
        .register-card p,
        .register-form p,
        .form-container p {

            color:
                #B7B9C1 !important;
        }


        /* ============================================================
           LABELS
        ============================================================ */

        .register-container label,
        .register-card label,
        .register-form label,
        .form-container label {

            color:
                #E8E9ED !important;

            font-weight:
                600 !important;

            letter-spacing:
                0.2px;
        }


        /* ============================================================
           INPUTS
        ============================================================ */

        .register-container input,
        .register-card input,
        .register-form input,
        .form-container input,
        .register-container select,
        .register-card select,
        .register-form select,
        .form-container select,
        .register-container textarea,
        .register-card textarea,
        .register-form textarea,
        .form-container textarea {

            background:
                linear-gradient(
                    145deg,
                    #303136,
                    #28292F
                ) !important;

            background-color:
                #303136 !important;

            color:
                #FFFFFF !important;

            border:
                1px solid #4B4C53 !important;

            border-radius:
                10px !important;

            outline:
                none !important;

            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.025) !important;

            transition:
                all 0.25s ease !important;
        }


        /* ============================================================
           INPUT HOVER
        ============================================================ */

        .register-container input:hover,
        .register-card input:hover,
        .register-form input:hover,
        .form-container input:hover,
        .register-container select:hover,
        .register-card select:hover,
        .register-form select:hover,
        .form-container select:hover {

            background:
                linear-gradient(
                    145deg,
                    #35363C,
                    #2C2D33
                ) !important;

            border-color:
                #666872 !important;
        }


        /* ============================================================
           INPUT FOCUS
        ============================================================ */

        .register-container input:focus,
        .register-card input:focus,
        .register-form input:focus,
        .form-container input:focus,
        .register-container select:focus,
        .register-card select:focus,
        .register-form select:focus,
        .form-container select:focus,
        .register-container textarea:focus,
        .register-card textarea:focus,
        .register-form textarea:focus,
        .form-container textarea:focus {

            background:
                #303136 !important;

            color:
                #FFFFFF !important;

            border-color:
                #D6A85F !important;

            outline:
                none !important;

            box-shadow:
                0 0 0 3px rgba(214,168,95,0.12),
                0 8px 20px rgba(0,0,0,0.20) !important;
        }


        /* ============================================================
           PLACEHOLDER
        ============================================================ */

        .register-container input::placeholder,
        .register-card input::placeholder,
        .register-form input::placeholder,
        .form-container input::placeholder,
        .register-container textarea::placeholder,
        .register-card textarea::placeholder,
        .register-form textarea::placeholder,
        .form-container textarea::placeholder {

            color:
                #9FA2AA !important;

            opacity:
                1 !important;
        }


        /* ============================================================
           SELECT OPTIONS
        ============================================================ */

        .register-container select option,
        .register-card select option,
        .register-form select option,
        .form-container select option,
        select option {

            background:
                #24252B !important;

            color:
                #FFFFFF !important;
        }


        /* ============================================================
           ACCOUNT TYPE INFO BOX
           BLUE → CHARCOAL
        ============================================================ */

        .register-card .bg-blue-50,
        .register-form .bg-blue-50,
        .form-container .bg-blue-50,
        .register-card [class*="bg-blue-50"],
        .register-form [class*="bg-blue-50"],
        .form-container [class*="bg-blue-50"] {

            background:
                linear-gradient(
                    145deg,
                    #303136,
                    #25262B
                ) !important;

            color:
                #E8E9ED !important;

            border:
                1px solid #46474E !important;

            border-radius:
                12px !important;

            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.03),
                0 8px 18px rgba(0,0,0,0.15) !important;
        }


        .register-card .bg-blue-50 *,
        .register-form .bg-blue-50 *,
        .form-container .bg-blue-50 *,
        .register-card [class*="bg-blue-50"] *,
        .register-form [class*="bg-blue-50"] *,
        .form-container [class*="bg-blue-50"] * {

            color:
                #D9DBE0 !important;
        }


        /* Account Type title */

        .register-card .bg-blue-50 .text-blue-700,
        .register-card .bg-blue-50 .text-blue-800,
        .register-card .bg-blue-50 .text-blue-900,
        .register-form .bg-blue-50 .text-blue-700,
        .register-form .bg-blue-50 .text-blue-800,
        .register-form .bg-blue-50 .text-blue-900,
        .form-container .bg-blue-50 .text-blue-700,
        .form-container .bg-blue-50 .text-blue-800,
        .form-container .bg-blue-50 .text-blue-900 {

            color:
                #FFFFFF !important;

            font-weight:
                600 !important;
        }


        /* Account Type description */

        .register-card .bg-blue-50 .text-blue-600,
        .register-card .bg-blue-50 .text-blue-500,
        .register-form .bg-blue-50 .text-blue-600,
        .register-form .bg-blue-50 .text-blue-500,
        .form-container .bg-blue-50 .text-blue-600,
        .form-container .bg-blue-50 .text-blue-500 {

            color:
                #AEB0B8 !important;
        }


        /* Account Type icon */

        .register-card .bg-blue-50 i,
        .register-card .bg-blue-50 svg,
        .register-form .bg-blue-50 i,
        .register-form .bg-blue-50 svg,
        .form-container .bg-blue-50 i,
        .form-container .bg-blue-50 svg {

            color:
                #D04460 !important;

            background:
                rgba(189,54,84,0.12) !important;

            border-radius:
                8px;

            padding:
                5px;
        }


        /* ============================================================
           BLUE BORDERS → CHARCOAL
        ============================================================ */

        .register-card .border-blue-100,
        .register-card .border-blue-200,
        .register-card .border-blue-300,
        .register-form .border-blue-100,
        .register-form .border-blue-200,
        .register-form .border-blue-300,
        .form-container .border-blue-100,
        .form-container .border-blue-200,
        .form-container .border-blue-300 {

            border-color:
                #46474E !important;
        }


        /* ============================================================
           WHITE BOXES → CHARCOAL
        ============================================================ */

        .register-card .bg-white,
        .register-form .bg-white,
        .form-container .bg-white {

            background:
                linear-gradient(
                    145deg,
                    #303136,
                    #25262B
                ) !important;

            color:
                #FFFFFF !important;

            border-color:
                #46474E !important;
        }


        .register-card .bg-white *,
        .register-form .bg-white *,
        .form-container .bg-white * {

            color:
                #E8E9ED !important;
        }


        /* ============================================================
           LIGHT BOXES
        ============================================================ */

        .register-card .bg-gray-50,
        .register-card .bg-gray-100,
        .register-card .bg-slate-50,
        .register-card .bg-slate-100,
        .register-form .bg-gray-50,
        .register-form .bg-gray-100,
        .register-form .bg-slate-50,
        .register-form .bg-slate-100,
        .form-container .bg-gray-50,
        .form-container .bg-gray-100,
        .form-container .bg-slate-50,
        .form-container .bg-slate-100 {

            background:
                #292A30 !important;

            color:
                #FFFFFF !important;

            border-color:
                #46474E !important;
        }


        /* ============================================================
           CREATE ACCOUNT BUTTON
           DARK RED / WINE
        ============================================================ */

        .register-container button,
        .register-card button,
        .register-form button,
        .form-container button,
        .register-container input[type="submit"],
        .register-card input[type="submit"],
        .register-form input[type="submit"],
        .form-container input[type="submit"] {

            background:
                linear-gradient(
                    135deg,
                    #C23855,
                    #94233E
                ) !important;

            color:
                #FFFFFF !important;

            border:
                1px solid rgba(255,255,255,0.08) !important;

            border-radius:
                10px !important;

            font-weight:
                600 !important;

            box-shadow:
                0 10px 25px rgba(189,54,84,0.25) !important;

            transition:
                all 0.25s ease !important;
        }


        /* ============================================================
           BUTTON HOVER
        ============================================================ */

        .register-container button:hover,
        .register-card button:hover,
        .register-form button:hover,
        .form-container button:hover,
        .register-container input[type="submit"]:hover,
        .register-card input[type="submit"]:hover,
        .register-form input[type="submit"]:hover,
        .form-container input[type="submit"]:hover {

            background:
                linear-gradient(
                    135deg,
                    #D04460,
                    #A52A46
                ) !important;

            color:
                #FFFFFF !important;

            transform:
                translateY(-2px);

            box-shadow:
                0 15px 32px rgba(189,54,84,0.35) !important;
        }


        /* ============================================================
           LINKS
        ============================================================ */

        .register-container a,
        .register-card a,
        .register-form a,
        .form-container a {

            color:
                #E05A72 !important;

            text-decoration:
                none !important;

            transition:
                color 0.2s ease;
        }


        .register-container a:hover,
        .register-card a:hover,
        .register-form a:hover,
        .form-container a:hover {

            color:
                #F0788D !important;

            text-decoration:
                underline !important;
        }


        /* ============================================================
           SMALL TEXT
        ============================================================ */

        .register-container small,
        .register-card small,
        .register-form small,
        .form-container small {

            color:
                #AEB0B8 !important;
        }


        /* ============================================================
           VALIDATION ERROR
        ============================================================ */

        .register-container .text-danger,
        .register-card .text-danger,
        .register-form .text-danger,
        .form-container .text-danger,
        .register-container .field-validation-error,
        .register-card .field-validation-error,
        .register-form .field-validation-error,
        .form-container .field-validation-error {

            color:
                #F0788D !important;
        }


        /* ============================================================
           SUCCESS MESSAGE
        ============================================================ */

        .register-container .alert-success,
        .register-card .alert-success,
        .register-form .alert-success,
        .form-container .alert-success {

            background:
                rgba(52,190,140,0.12) !important;

            color:
                #63E0B0 !important;

            border:
                1px solid rgba(95,224,175,0.20) !important;

            border-radius:
                10px !important;
        }


        /* ============================================================
           ERROR MESSAGE
        ============================================================ */

        .register-container .alert-danger,
        .register-card .alert-danger,
        .register-form .alert-danger,
        .form-container .alert-danger {

            background:
                rgba(189,54,84,0.12) !important;

            color:
                #F0788D !important;

            border:
                1px solid rgba(189,54,84,0.25) !important;

            border-radius:
                10px !important;
        }


        /* ============================================================
           CHECKBOX
        ============================================================ */

        .register-container input[type="checkbox"],
        .register-card input[type="checkbox"],
        .register-form input[type="checkbox"],
        .form-container input[type="checkbox"] {

            accent-color:
                #BD3654 !important;

            width:
                16px !important;

            height:
                16px !important;
        }


        /* ============================================================
           AUTOFILL FIX
        ============================================================ */

        .register-container input:-webkit-autofill,
        .register-card input:-webkit-autofill,
        .register-form input:-webkit-autofill,
        .form-container input:-webkit-autofill,
        .register-container input:-webkit-autofill:hover,
        .register-card input:-webkit-autofill:hover,
        .register-form input:-webkit-autofill:hover,
        .form-container input:-webkit-autofill:hover,
        .register-container input:-webkit-autofill:focus,
        .register-card input:-webkit-autofill:focus,
        .register-form input:-webkit-autofill:focus,
        .form-container input:-webkit-autofill:focus {

            -webkit-text-fill-color:
                #FFFFFF !important;

            background-color:
                #303136 !important;

            box-shadow:
                0 0 0 1000px #303136 inset !important;

            -webkit-box-shadow:
                0 0 0 1000px #303136 inset !important;
        }


        /* ============================================================
           ROLE SELECT
        ============================================================ */

        #Role {

            cursor:
                pointer !important;
        }


        /* ============================================================
           DOCTOR APPROVAL INFO
        ============================================================ */

        .doctor-approval-note {

            margin-top:
                10px;

            padding:
                10px 12px;

            border-radius:
                9px;

            background:
                rgba(214,168,95,0.08);

            border:
                1px solid rgba(214,168,95,0.20);

            color:
                #D6A85F !important;

            font-size:
                12px;

            line-height:
                1.5;
        }


        /* ============================================================
           MOBILE
        ============================================================ */

        @@media (max-width: 768px) {

            body {

                background:
                    linear-gradient(
                        180deg,
                        #06152D,
                        #071A33
                    ) !important;
            }


            .register-container {

                background:
                    #06152D !important;

                padding:
                    15px !important;
            }


            .register-card {

                background:
                    linear-gradient(
                        145deg,
                        #292A30,
                        #18191D
                    ) !important;

                border-radius:
                    16px !important;
            }


            .register-card > div:first-child {

                background:
                    linear-gradient(
                        135deg,
                        #3A252B,
                        #292A30,
                        #202126
                    ) !important;

                border-bottom:
                    1px solid rgba(189,54,84,0.35) !important;
            }


            .register-container input,
            .register-card input,
            .register-form input,
            .form-container input,
            .register-container select,
            .register-card select,
            .register-form select,
            .form-container select {

                background:
                    #303136 !important;

                color:
                    #FFFFFF !important;
            }


            .register-card .bg-blue-50,
            .register-form .bg-blue-50,
            .form-container .bg-blue-50 {

                background:
                    #292A30 !important;

                border-color:
                    #46474E !important;
            }


            .register-card .bg-white,
            .register-form .bg-white,
            .form-container .bg-white {

                background:
                    #292A30 !important;

                color:
                    #FFFFFF !important;
            }
        }

    </style>

</head>


<body>

    <div class="register-container min-h-screen flex items-center justify-center px-4 py-10">

        <div class="register-card w-full max-w-lg bg-white rounded-3xl overflow-hidden">


            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <div class="bg-gradient-to-r from-blue-700 to-cyan-600 px-8 py-8 text-white">

                <div class="flex items-center gap-3 mb-4">

                    <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center">

                        <span class="text-2xl">
                            ❤
                        </span>

                    </div>


                    <div>

                        <h1 class="text-2xl font-bold">
                            HealthCare
                        </h1>

                        <p class="text-blue-100 text-sm">
                            Management System
                        </p>

                    </div>

                </div>


                <h2 class="text-3xl font-bold">
                    Create New Account
                </h2>


                <p class="text-blue-100 mt-2">
                    Register your account to access healthcare services.
                </p>

            </div>


            <!-- =====================================================
                 FORM
            ====================================================== -->

            <div class="p-8">


                <!-- VALIDATION SUMMARY -->

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 rounded-xl bg-red-50 border border-red-200 p-4">

                        <div class="font-semibold text-red-700 mb-2">
                            Please fix the following errors:
                        </div>

                        <div asp-validation-summary="All"
                             class="text-sm text-red-600">
                        </div>

                    </div>
                }


                <form asp-controller="Account"
                      asp-action="Register"
                      method="post"
                      autocomplete="off">

                    @Html.AntiForgeryToken()


                    <!-- =================================================
                         FULL NAME
                    ================================================== -->

                    <div class="mb-5">

                        <label asp-for="FullName"
                               class="block text-sm font-semibold text-gray-700 mb-2">

                            Full Name

                        </label>


                        <input asp-for="FullName"
                               class="input-field w-full px-4 py-3 rounded-xl border border-gray-300"
                               placeholder="Enter your full name"
                               autocomplete="name" />


                        <span asp-validation-for="FullName"
                              class="text-red-500 text-sm mt-1 block">
                        </span>

                    </div>


                    <!-- =================================================
                         EMAIL
                    ================================================== -->

                    <div class="mb-5">

                        <label asp-for="Email"
                               class="block text-sm font-semibold text-gray-700 mb-2">

                            Email Address

                        </label>


                        <input asp-for="Email"
                               type="email"
                               class="input-field w-full px-4 py-3 rounded-xl border border-gray-300"
                               placeholder="Enter your email"
                               autocomplete="email" />


                        <span asp-validation-for="Email"
                              class="text-red-500 text-sm mt-1 block">
                        </span>

                    </div>


                    <!-- =================================================
                         PHONE
                    ================================================== -->

                    <div class="mb-5">

                        <label asp-for="PhoneNumber"
                               class="block text-sm font-semibold text-gray-700 mb-2">

                            Phone Number

                        </label>


                        <input asp-for="PhoneNumber"
                               id="phoneNumber"
                               type="text"
                               inputmode="numeric"
                               maxlength="10"
                               pattern="[0-9]{10}"
                               class="input-field w-full px-4 py-3 rounded-xl border border-gray-300"
                               placeholder="Enter 10 digit phone number"
                               autocomplete="tel" />


                        <span asp-validation-for="PhoneNumber"
                              class="text-red-500 text-sm mt-1 block">
                        </span>


                        <p class="text-xs text-gray-500 mt-1">

                            Phone number must contain exactly 10 digits.

                        </p>

                    </div>


                    <!-- =================================================
                         ROLE
                    ================================================== -->

                    <div class="mb-5">

                        <label asp-for="Role"
                               class="block text-sm font-semibold text-gray-700 mb-2">

                            Select Role

                        </label>


                        <select asp-for="Role"
                                id="Role"
                                class="input-field w-full px-4 py-3 rounded-xl border border-gray-300 bg-white">

                            <option value="">
                                -- Select Role --
                            </option>

                            <option value="Patient">
                                Patient
                            </option>

                            <option value="Doctor">
                                Doctor
                            </option>

                            <option value="Receptionist">
                                Receptionist
                            </option>

                            <option value="Laboratory">
                                Laboratory
                            </option>

                        </select>


                        <span asp-validation-for="Role"
                              class="text-red-500 text-sm mt-1 block">
                        </span>


                        <!-- DOCTOR APPROVAL MESSAGE -->

                        <div id="doctorApprovalNote"
                             class="doctor-approval-note"
                             style="display:none;">

                            <strong>Doctor Registration:</strong>
                            Your doctor account will require administrator
                            approval before you can log in.

                        </div>

                    </div>


                    <!-- =================================================
                         PASSWORD
                    ================================================== -->

                    <div class="mb-5">

                        <label asp-for="Password"
                               class="block text-sm font-semibold text-gray-700 mb-2">

                            Password

                        </label>


                        <input asp-for="Password"
                               type="password"
                               class="input-field w-full px-4 py-3 rounded-xl border border-gray-300"
                               placeholder="Create a password"
                               autocomplete="new-password" />


                        <span asp-validation-for="Password"
                              class="text-red-500 text-sm mt-1 block">
                        </span>

                    </div>


                    <!-- =================================================
                         CONFIRM PASSWORD
                    ================================================== -->

                    <div class="mb-6">

                        <label asp-for="ConfirmPassword"
                               class="block text-sm font-semibold text-gray-700 mb-2">

                            Confirm Password

                        </label>


                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="input-field w-full px-4 py-3 rounded-xl border border-gray-300"
                               placeholder="Confirm your password"
                               autocomplete="new-password" />


                        <span asp-validation-for="ConfirmPassword"
                              class="text-red-500 text-sm mt-1 block">
                        </span>

                    </div>


                    <!-- =================================================
                         ACCOUNT TYPE INFO
                    ================================================== -->

                    <div class="mb-6 rounded-xl bg-blue-50 border border-blue-100 p-4">

                        <div class="flex gap-3">

                            <div class="text-blue-600 text-xl">

                                ℹ

                            </div>


                            <div>

                                <p class="text-sm font-semibold text-blue-800">

                                    Account Type

                                </p>


                                <p class="text-xs text-blue-700 mt-1">

                                    Select the role for the account you want
                                    to create.

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         REGISTER BUTTON
                    ================================================== -->

                    <button type="submit"
                            class="w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold transition">

                        Create Account

                    </button>

                </form>


                <!-- =====================================================
                     LOGIN
                ====================================================== -->

                <div class="text-center mt-6">

                    <span class="text-gray-600 text-sm">

                        Already have an account?

                    </span>


                    <a href="/Account/Login"
                       class="text-blue-600 hover:text-blue-800 font-semibold text-sm ml-1">

                        Login

                    </a>

                </div>


                <!-- =====================================================
                     BACK HOME
                ====================================================== -->

                <div class="text-center mt-4">

                    <a href="/"
                       class="text-gray-500 hover:text-blue-600 text-sm">

                        ← Back to Home

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =============================================================
         PHONE ONLY DIGITS
    ============================================================= -->

    <script>

        const phoneInput =
            document.getElementById("phoneNumber");

        if (phoneInput) {

            phoneInput.addEventListener("input", function () {

                this.value = this.value
                    .replace(/\D/g, "")
                    .slice(0, 10);

            });

        }


        /* ============================================================
           DOCTOR APPROVAL MESSAGE
        ============================================================ */

        const roleInput =
            document.getElementById("Role");

        const doctorApprovalNote =
            document.getElementById("doctorApprovalNote");


        function updateDoctorMessage() {

            if (!roleInput || !doctorApprovalNote) {
                return;
            }

            if (roleInput.value === "Doctor") {

                doctorApprovalNote.style.display = "block";

            }
            else {

                doctorApprovalNote.style.display = "none";

            }
        }


        if (roleInput) {

            roleInput.addEventListener(
                "change",
                updateDoctorMessage
            );

            updateDoctorMessage();
        }

    </script>


    <!-- CLIENT VALIDATION -->

    <partial name="_ValidationScriptsPartial" />

</body>

</html>