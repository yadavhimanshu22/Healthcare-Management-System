@{ ViewData["Title"]="Receptionist Dashboard"; }
<div class="container py-5"><h1>Receptionist Dashboard</h1><div class="row g-3 mt-3"><div class="col-md-4"><div class="stat-card"><span>Patients</span><strong>@ViewBag.Patients</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Doctors</span><strong>@ViewBag.Doctors</strong></div></div><div class="col-md-4"><div class="stat-card"><span>Today's Appointments</span><strong>@ViewBag.TodayAppointments</strong></div></div></div><a class="btn btn-primary mt-4" asp-controller="Appointment" asp-action="Index">Manage Appointments</a></div>
