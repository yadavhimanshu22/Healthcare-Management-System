@model IEnumerable<Bill>
@{ ViewData["Title"]="Bills"; }
<div class="container py-5"><h2>Bills</h2><table class="table"><thead><tr><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.CreatedAt.ToString("dd-MM-yyyy")</td><td>₹@b.TotalAmount</td><td>@b.PaymentStatus</td></tr>}</tbody></table></div>
