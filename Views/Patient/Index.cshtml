@model Patient
@{ ViewData["Title"]="Patient Dashboard"; }
<div class="container py-5"><h1>Welcome, @Model.FullName</h1><div class="row g-3 mt-3">
<div class="col-md-3"><div class="stat-card"><span>Upcoming</span><strong>@ViewBag.Upcoming</strong></div></div>
<div class="col-md-3"><div class="stat-card"><span>Prescriptions</span><strong>@ViewBag.Prescriptions</strong></div></div>
<div class="col-md-3"><div class="stat-card"><span>Records</span><strong>@ViewBag.Records</strong></div></div>
<div class="col-md-3"><div class="stat-card"><span>Pending Bills</span><strong>@ViewBag.Bills</strong></div></div>
</div><div class="mt-4"><a class="btn btn-primary me-2" asp-controller="Appointment" asp-action="Create">Book Appointment</a><a class="btn btn-outline-primary me-2" asp-action="Records">Medical Records</a><a class="btn btn-outline-primary me-2" asp-action="Prescriptions">Prescriptions</a><a class="btn btn-outline-primary" asp-action="Bills">Bills</a></div></div>
