@{
    ViewData["Title"] = "Patient Dashboard";

    var userName = User.Identity?.Name ?? "Patient";
}

<div class="patient-dashboard">

    <!-- HEADER -->
    <div class="dashboard-header">

        <div>
            <span class="dashboard-label">PATIENT PORTAL</span>

            <h1>
                Welcome, @userName
            </h1>

            <p>
                Manage your appointments, medical records and healthcare information.
            </p>
        </div>

        <div class="patient-avatar">
            @(userName.Substring(0, 1).ToUpper())
        </div>

    </div>


    <!-- STAT CARDS -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon">📅</div>

            <div>
                <h3>0</h3>
                <p>Upcoming Appointments</p>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon">📋</div>

            <div>
                <h3>0</h3>
                <p>Medical Records</p>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon">💊</div>

            <div>
                <h3>0</h3>
                <p>Prescriptions</p>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon">🧪</div>

            <div>
                <h3>0</h3>
                <p>Laboratory Reports</p>
            </div>
        </div>

    </div>


    <!-- QUICK ACTIONS -->
    <div class="section-title">

        <div>
            <h2>Quick Actions</h2>

            <p>
                Access your healthcare services quickly.
            </p>
        </div>

    </div>


    <div class="action-grid">

        <!-- APPOINTMENT -->
        <a asp-controller="Appointment"
           asp-action="Index"
           class="action-card">

            <div class="action-icon">
                📅
            </div>

            <div>
                <h3>Appointments</h3>

                <p>
                    Book and manage your doctor appointments.
                </p>

                <span>
                    View Appointments →
                </span>
            </div>

        </a>


        <!-- MEDICAL RECORDS -->
        <a asp-controller="MedicalRecord"
           asp-action="Index"
           class="action-card">

            <div class="action-icon">
                📋
            </div>

            <div>
                <h3>Medical Records</h3>

                <p>
                    View your medical history and records.
                </p>

                <span>
                    View Records →
                </span>
            </div>

        </a>


        <!-- PRESCRIPTIONS -->
        <a asp-controller="Prescription"
           asp-action="Index"
           class="action-card">

            <div class="action-icon">
                💊
            </div>

            <div>
                <h3>Prescriptions</h3>

                <p>
                    View your medicines and prescriptions.
                </p>

                <span>
                    View Prescriptions →
                </span>
            </div>

        </a>


        <!-- LAB REPORTS -->
        <a asp-controller="Laboratory"
           asp-action="Index"
           class="action-card">

            <div class="action-icon">
                🧪
            </div>

            <div>
                <h3>Laboratory Reports</h3>

                <p>
                    View your laboratory test reports.
                </p>

                <span>
                    View Reports →
                </span>
            </div>

        </a>

    </div>


    <!-- PROFILE -->
    <div class="profile-section">

        <div>

            <h2>My Profile</h2>

            <p>
                View and manage your personal information.
            </p>

        </div>

        <a asp-controller="Account"
           asp-action="Profile"
           class="profile-button">

            View Profile →

        </a>

    </div>

</div>


<style>

    .patient-dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px 60px;
    }


    /* HEADER */

    .dashboard-header {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        color: white;
        border-radius: 20px;
        padding: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(13, 110, 253, 0.18);
    }


    .dashboard-label {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
        opacity: 0.85;
    }


    .dashboard-header h1 {
        margin: 8px 0;
        font-size: 32px;
        font-weight: 700;
    }


    .dashboard-header p {
        margin: 0;
        opacity: 0.9;
    }


    .patient-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: white;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        font-weight: 700;
        flex-shrink: 0;
    }


    /* STATS */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }


    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 1px solid #e8eef5;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }


    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #eaf3ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }


    .stat-card h3 {
        margin: 0;
        font-size: 26px;
        color: #17324d;
    }


    .stat-card p {
        margin: 3px 0 0;
        color: #6c757d;
        font-size: 14px;
    }


    /* SECTION */

    .section-title {
        margin-bottom: 20px;
    }


    .section-title h2 {
        margin: 0;
        color: #17324d;
        font-size: 25px;
    }


    .section-title p {
        margin-top: 5px;
        color: #6c757d;
    }


    /* ACTION CARDS */

    .action-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }


    .action-card {
        background: white;
        border: 1px solid #e8eef5;
        border-radius: 16px;
        padding: 25px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
        text-decoration: none;
        color: inherit;
        transition: 0.25s ease;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    }


    .action-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.09);
        border-color: #0d6efd;
    }


    .action-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: #eaf3ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }


    .action-card h3 {
        margin: 0 0 7px;
        color: #17324d;
    }


    .action-card p {
        margin: 0 0 10px;
        color: #6c757d;
        line-height: 1.5;
    }


    .action-card span {
        color: #0d6efd;
        font-weight: 600;
        font-size: 14px;
    }


    /* PROFILE */

    .profile-section {
        background: white;
        border-radius: 16px;
        border: 1px solid #e8eef5;
        padding: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .profile-section h2 {
        margin: 0;
        color: #17324d;
    }


    .profile-section p {
        margin: 5px 0 0;
        color: #6c757d;
    }


    .profile-button {
        background: #0d6efd;
        color: white;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 9px;
        font-weight: 600;
    }


    .profile-button:hover {
        background: #0b5ed7;
        color: white;
    }


    @@media (max-width: 900px) {

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .action-grid {
            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 600px) {

        .dashboard-header {
            padding: 25px;
        }

        .dashboard-header h1 {
            font-size: 25px;
        }

        .patient-avatar {
            width: 60px;
            height: 60px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .profile-section {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

    }

</style>